# Marketing (Quartier Generale): app LinkedIn per sviluppatori; URL di ritorno = QUANTO_PUBLIC_URL + /api/v2/marketing/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES_PROFILE=          # default: openid profile w_member_social
LINKEDIN_SCOPES_PAGE=
QUANTO_PUBLIC_URL=                 # default https://quanto-self.vercel.app
