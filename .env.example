# Tutte le variabili di QUANTO, senza valori. Backend: copia backend/.env.example in backend/.env (descrizioni lì). Frontend: copia questo blocco in frontend/.env.local se serve.

# --- Frontend (Vite)
VITE_API_BASE=                    # base delle API; vuoto = stessa origine (/api/v2)

# --- Backend (descrizioni in backend/.env.example)
QUANTO_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=
QUANTO_DB_POOL_MAX=
QUANTO_TEST_DATABASE_URL=
QUANTO_SIGNING_KEY=
QUANTO_TRUSTED_PUBLIC_KEYS=
QUANTO_AUTH_REQUIRED=
QUANTO_JWT_SECRET=
QUANTO_HMAC_SECRET=
QUANTO_OAUTH_CLIENTS=
QUANTO_PII_KEY=
QUANTO_FILE_KEY=
QUANTO_CORS_ORIGINS=
CRON_SECRET=
QUANTO_OWNER_EMAIL=
QUANTO_BOOTSTRAP_ADMIN_EMAIL=
QUANTO_BOOTSTRAP_ADMIN_PASSWORD=
QUANTO_BRAVE_API_KEY=
QUANTO_SERPER_API_KEY=
QUANTO_TAVILY_API_KEY=
ANTHROPIC_API_KEY=
QUANTO_LLM_API_KEY=
QUANTO_LLM_PROVIDER=
