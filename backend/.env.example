# Copia in .env (NON committare .env). Su Vercel: Project Settings > Environment Variables.

# --- Registro di asseverazione (catena di hash firmata Ed25519)
QUANTO_SIGNING_KEY=               # 32 byte: hex (64 caratteri) o base64. Genera:  python -c "import os;print(os.urandom(32).hex())"
QUANTO_TRUSTED_PUBLIC_KEYS=       # opzionale: chiavi pubbliche precedenti (hex, separate da virgola) dopo una rotazione
QUANTO_DB_PATH=                   # SQLite (registro + ingestion). Default: cartella temporanea (volatile su serverless!)

# --- Sicurezza / integrazione ERP
QUANTO_AUTH_REQUIRED=0            # 1 = richiede Bearer OAuth2 o firma HMAC su tutte le API di calcolo/scrittura
QUANTO_OAUTH_CLIENTS=             # "client_id:segreto,client_id2:segreto2"
QUANTO_JWT_SECRET=                # segreto HS256 dei bearer token
QUANTO_HMAC_SECRET=               # segreto della firma HMAC delle richieste
QUANTO_PII_KEY=                   # chiave HMAC per i token di pseudonimizzazione (obbligatoria in produzione)
QUANTO_CORS_ORIGINS=http://localhost:5173

# --- Quartier Generale (area manager)
QUANTO_HQ_CODE=                   # codice d'accesso all'HQ. Se vuoto vale il codice di default QUANTO_1 (DEBOLE: cambialo in produzione)

# --- Webhook (opzionali; firmati HMAC-SHA256)
QUANTO_WEBHOOK_URLS=
QUANTO_WEBHOOK_SECRET=

# --- Varie
QUANTO_PUBLIC_URL=http://localhost:5173  # base URL del QR verso l'Auditor Portal negli export
