# Variabili del backend. Copia in .env e compila (NON committare .env). Su Vercel: Project Settings > Environment Variables.
# Nessun valore qui: i default sono scritti nel commento di ogni riga.

# --- Database (PostgreSQL). Basta una delle tre; nei test si usa QUANTO_TEST_DATABASE_URL o un Postgres incorporato.
QUANTO_DATABASE_URL=              # postgresql://utente:password@host/db
DATABASE_URL=                     # alternativa (Neon, Supabase)
POSTGRES_URL=                     # alternativa (Vercel Postgres)
QUANTO_DB_POOL_MAX=               # connessioni massime del pool (default 8)
QUANTO_TEST_DATABASE_URL=         # solo per i test (CI)

# --- Registro firmato (catena di hash Ed25519)
QUANTO_SIGNING_KEY=               # 32 byte hex (64 caratteri) o base64:  python -c "import os;print(os.urandom(32).hex())"
QUANTO_TRUSTED_PUBLIC_KEYS=       # chiavi pubbliche precedenti dopo una rotazione (hex, separate da virgola)

# --- Sicurezza
QUANTO_AUTH_REQUIRED=             # 1 = accesso obbligatorio alle API (produzione); vuoto/0 in sviluppo
QUANTO_JWT_SECRET=                # segreto HS256 dei token di sessione
QUANTO_HMAC_SECRET=               # segreto della firma HMAC delle richieste (integrazioni)
QUANTO_OAUTH_CLIENTS=             # "client_id:segreto,client_id2:segreto2"
QUANTO_PII_KEY=                   # chiave HMAC della pseudonimizzazione (obbligatoria)
QUANTO_FILE_KEY=                  # 32 byte hex/base64: cifra i documenti caricati (senza, i file non si caricano)
QUANTO_CORS_ORIGINS=              # es. http://localhost:5173
CRON_SECRET=                      # segreto dei lavori pianificati di Vercel (/api/v2/cron/*)

# --- Account
QUANTO_OWNER_EMAIL=               # unico account ammesso al Quartier Generale
QUANTO_BOOTSTRAP_ADMIN_EMAIL=     # primo manager, solo se non esiste nessun utente (poi togliere)
QUANTO_BOOTSTRAP_ADMIN_PASSWORD=  # idem

# --- Ricerca dei bandi sul web (facoltative)
QUANTO_BRAVE_API_KEY=
QUANTO_SERPER_API_KEY=
QUANTO_TAVILY_API_KEY=

# --- Modello linguistico (facoltativo: senza chiave tutto resta deterministico e nulla viene chiamato)
ANTHROPIC_API_KEY=
QUANTO_LLM_API_KEY=               # alternativa ad ANTHROPIC_API_KEY
QUANTO_LLM_PROVIDER=              # default anthropic
QUANTO_LLM_MODEL=
QUANTO_LLM_PASSES=                # default 3 (da 2 a 7)

# --- Lettura dei documenti
QUANTO_OCR_ENGINE=                # motore OCR per le scansioni (vuoto = nessuno)
QUANTO_TESSERACT_CMD=             # percorso di tesseract, se usato
QUANTO_FIELD_CONFIDENCE_MIN=      # soglia di sicurezza per campo letto
QUANTO_ALLOW_UNOFFICIAL_TABLES=   # 1 = ammette tabelle di Fonte B non ufficiali (sconsigliato)

# --- Prodotto
QUANTO_TOKENS_CHARGE=             # 1 = i token si scalano davvero. Lasciare vuoto/0: per ora tutto è gratuito
QUANTO_SEED_TEMPLATES=            # 0 = disattiva i template di esempio (default attivi)
QUANTO_PUBLIC_URL=                # URL pubblico (QR verso il portale del revisore)

# --- Webhook (facoltativi, firmati HMAC-SHA256)
QUANTO_WEBHOOK_URLS=
QUANTO_WEBHOOK_SECRET=

# Marketing (Quartier Generale): app LinkedIn per sviluppatori; URL di ritorno = QUANTO_PUBLIC_URL + /api/v2/marketing/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES_PROFILE=          # default: openid profile w_member_social
LINKEDIN_SCOPES_PAGE=
QUANTO_PUBLIC_URL=                 # default https://quanto-self.vercel.app
